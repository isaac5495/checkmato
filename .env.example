# Copy to .env and fill ONE of these (never paste keys in chat; gitignored)
# All have free tiers; CheckMato uses them only for optional assists and degrades
# to zero-LLM mode without a key.

# Agnes AI (OpenAI-compatible; agnes-2.5-flash currently $0, free 20 RPM)
#   sign up: https://platform.agnes-ai.com/  -> API keys
AGNES_API_KEY=

# Google Gemini (NOTE: free tier is geo-restricted in some regions)
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Other options (any OpenAI-compatible works via BASE_URL/MODEL):
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# OPTIONAL web-search backends (all free tiers; without them CheckMato still
# works via keyless ddgs + local SearXNG + Wikipedia API, just less reliably):
# Google Custom Search JSON API — 100 queries/day free, no card:
#   1) https://programmablesearchengine.google.com  -> create engine, tick
#      "Search the entire web", note the Search engine ID
#   2) https://console.cloud.google.com/apis/credentials -> API key (CSE only)
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# Brave Search API — independent index, 2,000 queries/month free:
#   https://api.search.brave.com/account  -> subscription key
BRAVEX_API_KEY=
